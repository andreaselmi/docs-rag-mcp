{
  "name": "docs-rag-mcp",
  "version": "0.1.0",
  "description": "Minimal local RAG MCP server: semantic search over your markdown docs, embeddings via Ollama, nothing leaves your machine.",
  "license": "MIT",
  "bin": {
    "docs-rag": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "AUTHORING.md",
    "LICENSE",
    "config.example.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreaselmi/docs-rag-mcp.git"
  },
  "homepage": "https://github.com/andreaselmi/docs-rag-mcp#readme",
  "bugs": {
    "url": "https://github.com/andreaselmi/docs-rag-mcp/issues"
  },
  "keywords": [
    "mcp",
    "rag",
    "semantic-search",
    "markdown",
    "ollama",
    "local-first",
    "claude-code"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "setup": "tsx src/setup.ts",
    "scaffold": "tsx src/scaffold.ts",
    "index": "tsx src/index-docs.ts",
    "search": "tsx src/search-cli.ts",
    "server": "tsx src/server.ts",
    "serve": "tsx src/server.ts",
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "prepack": "npm run build",
    "pack-skill": "bash scripts/pack-skill.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "globby": "^14.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
